{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["fingerprint", "account", "ticker", "side", "estimated_total", "status", "priority", "detail_status"],
  "properties": {
    "fingerprint": {"type": "string"},
    "account": {"enum": ["TFSA", "RRSP", "Non-registered"]},
    "ticker": {"type": "string"},
    "security": {"type": ["string", "null"]},
    "side": {"type": "string"},
    "order_type": {"type": ["string", "null"]},
    "limit_price": {"type": ["string", "null"]},
    "quantity": {"type": ["string", "null"]},
    "original_quantity": {"type": ["string", "null"]},
    "filled_quantity": {"type": ["string", "null"]},
    "remaining_quantity": {"type": ["string", "null"]},
    "remaining_quantity_basis": {"enum": ["explicit_remaining", "original_minus_filled", "unknown"]},
    "security_quote_currency": {"type": ["string", "null"]},
    "quantity_provenance": {
      "type": ["object", "null"],
      "properties": {
        "version": {"const": 1},
        "raw": {"type": "object"},
        "raw_labels": {"type": "object"},
        "problems": {"type": "array", "items": {"type": "string"}}
      }
    },
    "estimated_total": {"type": "string"},
    "submitted": {"type": ["string", "null"]},
    "expires": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "priority": {"type": "string"},
    "detail_status": {"enum": ["detail", "row_only", "cached_detail"]},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
